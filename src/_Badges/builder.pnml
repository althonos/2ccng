#define BUILDER_BADGE(x, y, z) \
    item(FEAT_BADGES, badge_builder_ ## x) {        \
        property {                                  \
            label: format_string("builder/%s", y);  \
            name: string(STR_BADGE_BUILDER_ ## z);  \
        }                                           \
    }

item(FEAT_BADGES, badge_builder) {
    property {
        label: "builder";
        name: string(STR_BADGE_BUILDER);
    }
}

