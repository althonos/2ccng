/*
* PURCHASE
*/

PURCHASE_SPRITESET(VEHIDCODE, "gfx/Railbus-steam/Mali_Kayes_Niger_No_1.xpm", 1, 128)

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_rbs_Mali_Kayes_Niger_No_1_engine1, "gfx/Railbus-steam/Mali_Kayes_Niger_No_1.xpm") {
	template_2cc_L12(1, 1)
}

spriteset(spriteset_rbs_Mali_Kayes_Niger_No_1_engine2, "gfx/Railbus-steam/Mali_Kayes_Niger_No_1.xpm") {
	template_2cc_L12(1, 38)
}

spriteset(spriteset_rbs_Mali_Kayes_Niger_No_1_loading, "gfx/Railbus-steam/Mali_Kayes_Niger_No_1.xpm") {
	template_2cc_L12(1, 75)
}

// Loading states - open door while loading
spritegroup spritegroup_rbs_Mali_Kayes_Niger_No_1_engine1_load {
	loading: spriteset_rbs_Mali_Kayes_Niger_No_1_loading;
	loaded:  spriteset_rbs_Mali_Kayes_Niger_No_1_engine1;
}

spritegroup spritegroup_rbs_Mali_Kayes_Niger_No_1_engine2_load {
	loading: spriteset_rbs_Mali_Kayes_Niger_No_1_loading;
	loaded:  spriteset_rbs_Mali_Kayes_Niger_No_1_engine2;
}


//Animation states
switch(FEAT_TRAINS, SELF, switch_rbs_Mali_Kayes_Niger_No_1_animation, motion_counter % 2){
	0: spritegroup_rbs_Mali_Kayes_Niger_No_1_engine1_load;
	spritegroup_rbs_Mali_Kayes_Niger_No_1_engine2_load;
}

switch(FEAT_TRAINS, SELF, switch_rbs_Mali_Kayes_Niger_No_1_position, position_in_vehid_chain % 2) {
	0: switch_rbs_Mali_Kayes_Niger_No_1_animation;
	EMPTY_SPRITESET
}

/*
* Visual effect
*/

switch(FEAT_TRAINS, SELF, switch_rbs_Mali_Kayes_Niger_No_1_visual_effect, position_in_vehid_chain % 3) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch(FEAT_TRAINS, SELF, switch_rbs_Mali_Kayes_Niger_No_1_length, position_in_vehid_chain % 3) {
	0: 8;
	1;
}

/*
* Articulated part
*/

switch(FEAT_TRAINS, SELF, switch_rbs_Mali_Kayes_Niger_No_1_articulated, extra_callback_info1) {
	1: return item_rbs_Mali_Kayes_Niger_No_1_trailer;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}


/*
* Cargo capacity
*/

ENGINECAPACITYSWITCH(VEHIDCODE)
WAGONCAPACITYSWITCH(VEHIDCODE)

//Add defined switches

RUNNINGCOSTENGINESWITCH

EXPANDEDPURCHASETEXTSWITCH(VEHIDCODE)